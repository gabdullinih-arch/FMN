{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Незабудка",
  "version": "0.1.0",
  "identifier": "com.planner.app",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend"
  },
  "app": {
    "security": {
      "capabilities": ["default"]
    },
    "windows": [
      { "title": "Незабудка · FMN", "width": 1200, "height": 800 }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU"
      }
    }
  }
}